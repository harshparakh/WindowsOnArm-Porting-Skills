{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/windows-on-arm-porting/woa-scout.schema.json",
  "title": "Windows on Arm Scout Assessment",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "release",
    "architecture",
    "buildSystems",
    "packaging",
    "risks",
    "scores",
    "effortEstimate",
    "deliveryWindow",
    "recommendation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": "string"
    },
    "repository": {
      "type": "object",
      "required": [
        "fullName",
        "defaultBranch",
        "analyzedCommit",
        "workingTreeDirty",
        "stars"
      ]
    },
    "release": {
      "type": "object"
    },
    "architecture": {
      "type": "object",
      "required": [
        "latestReleaseHasArm64Asset",
        "latestReleaseHasWindowsAsset",
        "releaseAssetGap",
        "x64ReferenceCount",
        "arm64ReferenceCount"
      ]
    },
    "buildSystems": {
      "type": "array"
    },
    "packaging": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "scores": {
      "type": "object",
      "required": [
        "customerImpact",
        "technicalRisk",
        "portingReadiness"
      ]
    },
    "effortEstimate": {
      "type": "object",
      "required": [
        "band",
        "minimumDays",
        "maximumDays",
        "rationale"
      ]
    },
    "deliveryWindow": {
      "type": "object",
      "required": [
        "days",
        "fit",
        "rationale"
      ],
      "properties": {
        "days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fit": {
          "enum": [
            "not-assessed",
            "strong",
            "conditional",
            "unlikely"
          ]
        }
      }
    },
    "recommendation": {
      "type": "string"
    }
  }
}
