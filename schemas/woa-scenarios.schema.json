{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/windows-on-arm-porting/woa-scenarios.schema.json",
  "title": "Windows on Arm Scenario Benchmark Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "application",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executableRelativePath",
        "workingDirectoryRelativePath",
        "arguments",
        "mainWindowSelector",
        "launchReadySteps"
      ],
      "properties": {
        "executableRelativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "workingDirectoryRelativePath": {
          "$ref": "#/$defs/relativeDirectoryPath"
        },
        "arguments": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "mainWindowSelector": {
          "$ref": "#/$defs/selector"
        },
        "launchReadySteps": {
          "$ref": "#/$defs/readOnlySteps"
        },
        "requiredPackageModules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\\\/:*?\"<>|]+\\.dll$"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300000
        },
        "pollingIntervalMilliseconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1000
        },
        "processExitTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        }
      }
    },
    "fixtures": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebabId"
          },
          "templatePath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "steps"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebabId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "timeoutMilliseconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 300000
          },
          "steps": {
            "$ref": "#/$defs/steps"
          }
        }
      }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z]:"
          },
          {
            "pattern": "^\\\\\\\\"
          },
          {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          },
          {
            "pattern": ":"
          },
          {
            "pattern": "(^|[\\\\/])[^\\\\/]*[. ]([\\\\/]|$)"
          },
          {
            "pattern": "(^|[\\\\/])(CON|PRN|AUX|NUL|CLOCK\\$|COM[1-9]|LPT[1-9])($|[.\\\\/])"
          }
        ]
      }
    },
    "relativeDirectoryPath": {
      "type": "string",
      "not": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z]:"
          },
          {
            "pattern": "^\\\\\\\\"
          },
          {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          },
          {
            "pattern": ":"
          },
          {
            "pattern": "(^|[\\\\/])[^\\\\/]*[. ]([\\\\/]|$)"
          },
          {
            "pattern": "(^|[\\\\/])(CON|PRN|AUX|NUL|CLOCK\\$|COM[1-9]|LPT[1-9])($|[.\\\\/])"
          }
        ]
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "controlType": {
          "enum": [
            "Button",
            "CheckBox",
            "ComboBox",
            "Custom",
            "DataItem",
            "Edit",
            "Hyperlink",
            "List",
            "ListItem",
            "MenuItem",
            "Pane",
            "RadioButton",
            "TabItem",
            "Text",
            "TreeItem",
            "Window"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "automationId"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ]
    },
    "readOnlySteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/step"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "wait-element",
                  "assert-element",
                  "wait-property",
                  "assert-property",
                  "wait-text",
                  "assert-text"
                ]
              }
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "type": {
          "enum": [
            "invoke",
            "toggle",
            "select",
            "set-value",
            "press-key",
            "wait-element",
            "assert-element",
            "wait-property",
            "assert-property",
            "wait-text",
            "assert-text"
          ]
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300000
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        },
        "key": {
          "enum": ["Enter", "Space"]
        },
        "property": {
          "enum": [
            "AutomationId",
            "Name",
            "ClassName",
            "ControlType",
            "HelpText",
            "Value",
            "ToggleState",
            "IsEnabled",
            "IsOffscreen"
          ]
        },
        "expected": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "expectedText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "invoke",
                  "toggle",
                  "select",
                  "set-value",
                  "press-key",
                  "wait-element",
                  "assert-element",
                  "wait-property",
                  "assert-property"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "press-key"}},
            "required": ["type"]
          },
          "then": {"required": ["key"]}
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set-value"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "wait-property",
                  "assert-property"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "property",
              "expected"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "wait-text",
                  "assert-text"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "expectedText"
            ]
          }
        }
      ]
    }
  }
}
